# Public Supabase client configuration.
# These values are safe to expose in browser bundles when Row Level Security is correctly enabled.
NEXT_PUBLIC_SITE_URL=https://drivemateparts.com.au
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side cookie authentication. Use a random 32+ byte value in each environment.
DRIVEMATE_SESSION_COOKIE_NAME=drivemate_session
DRIVEMATE_REFRESH_COOKIE_NAME=drivemate_refresh
DRIVEMATE_CSRF_COOKIE_NAME=drivemate_csrf
NEXT_PUBLIC_DRIVEMATE_CSRF_COOKIE_NAME=drivemate_csrf
DRIVEMATE_SESSION_MAX_AGE_SECONDS=3600
DRIVEMATE_REQUIRE_STAFF_MFA=false
DRIVEMATE_ENVIRONMENT=staging
DRIVEMATE_SUPABASE_ENVIRONMENT=staging

# Public account protection. Production release requires Turnstile to be enabled.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
DRIVEMATE_TURNSTILE_REQUIRED=false
DRIVEMATE_IMPORT_SIGNING_SECRET=

# Business profile used in account documents and release readiness checks.
DRIVEMATE_LEGAL_NAME=DRIVER MATE PTY LTD
DRIVEMATE_ABN=66701612768
DRIVEMATE_ACCOUNTS_EMAIL=accounts@drivemateparts.com.au
DRIVEMATE_WAREHOUSE_LABEL=Brisbane dispatch warehouse
# Keep false until the ABR shows an effective GST registration date.
DRIVEMATE_GST_REGISTERED=false

# Server-only key for trusted backend jobs. Never expose this in browser code.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCOUNT_DOCUMENTS_BUCKET=account-documents

# Staging-only user bootstrap. Use strong temporary passwords and rotate before production.
DRIVEMATE_SEED_TRADE_EMAIL=
DRIVEMATE_SEED_TRADE_PASSWORD=
DRIVEMATE_SEED_WAREHOUSE_EMAIL=
DRIVEMATE_SEED_WAREHOUSE_PASSWORD=
DRIVEMATE_SEED_ADMIN_EMAIL=
DRIVEMATE_SEED_ADMIN_PASSWORD=
DRIVEMATE_SEED_TRADE_ACCOUNT_NAME=DriveMate Demo Workshop
DRIVEMATE_SEED_TRADE_ACCOUNT_ABN=
REQUIRE_SUPABASE_USERS=false
REQUIRE_SUPABASE_STORAGE=false
REQUIRE_PI_IMPORT=false

# Staging app verification. Do not commit real access tokens.
DRIVEMATE_BASE_URL=http://127.0.0.1:3100
DRIVEMATE_SMOKE_USE_DEMO_HEADERS=false
DRIVEMATE_SMOKE_WRITE_CHECK=false
DRIVEMATE_SMOKE_E2E_CHECK=false
DRIVEMATE_SMOKE_MASTERDATA_CHECK=false
DRIVEMATE_SMOKE_ACCOUNT_PROVISION_CHECK=false
DRIVEMATE_SMOKE_E2E_SKU=DM-GWM-OF-001
DRIVEMATE_SMOKE_E2E_QTY=1
DRIVEMATE_SMOKE_TRADE_TOKEN=
DRIVEMATE_SMOKE_WAREHOUSE_TOKEN=
DRIVEMATE_SMOKE_ADMIN_TOKEN=
DRIVEMATE_SMOKE_WAREHOUSE_TOTP_CODE=
DRIVEMATE_SMOKE_ADMIN_TOTP_CODE=

# Strict release-readiness verification.
# Use a local, uncommitted .env.release.local for real values.
# npm run verify:release requires a deployed https staging URL, Supabase repository mode,
# real smoke tokens, required Supabase users/storage, and all staging write-path smoke checks.

# Demo-only role headers used before Supabase Auth is connected.
# Keep disabled in production. Production should derive role from Supabase JWT + user_profiles.role instead.
DRIVEMATE_ENABLE_DEMO_AUTH=false
NEXT_PUBLIC_SHOW_INTERNAL_NAV=false

# Repository mode.
# memory: local in-process demo store, useful for prototype and tests.
# supabase: use Supabase service client and SQL schema in supabase/.
DRIVEMATE_REPOSITORY=memory
